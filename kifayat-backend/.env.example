# Kifayat Backend — Required Environment Variables
# Copy this file to .env and fill in your values.
# Sensitive values should be stored in Replit Secrets, not committed here.

# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?appName=<app>

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<long-random-string>
JWT_EXPIRE=30d

# ── Firebase (Google OAuth) ────────────────────────────────────────────────────
# Option A: path to a service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B: full JSON contents as a single-line string (for Replit Secrets)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FIREBASE_PROJECT_ID=<your-firebase-project-id>

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Transactional mail (OTPs, order confirmations, receipts, admin alerts) is sent
# through a single Gmail account. Enable 2-Step Verification, then create an App
# Password at https://myaccount.google.com/apppasswords and paste it below.
EMAIL_USER=<gmail-address>
EMAIL_PASS=<gmail-app-password-without-spaces>   # 16 chars; spaces are stripped automatically
# Optional: send customer replies to a monitored inbox instead of the sender.
# REPLY_TO_EMAIL=support@yourdomain.com
# PUBLIC_APP_URL controls the storefront link used in order-confirmation emails.
# Set it in the Frontend / CORS section below.

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Public URL used in emailed links. Set this to the URL customers can open.
PUBLIC_APP_URL=https://your-frontend.example.com
# Backwards-compatible alias; PUBLIC_APP_URL takes precedence.
FRONTEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000
SITE_URL=http://localhost:5173
SITE_NAME=Kifayat

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com

# ── HHC Dropshipping API ──────────────────────────────────────────────────────
HHC_API_URL=https://member.hhcdropshipping.com/api
HHC_REFERER=https://member.hhcdropshipping.com/
HHC_ORIGIN=https://member.hhcdropshipping.com

# ── AI product copy and categorization ───────────────────────────────────────
GROQ_API_KEY=gsk_<your-groq-key>

# ── Error Monitoring (Sentry) ───────────────────────────────────────────────────
# Optional: Add Sentry DSN for production error tracking
# SENTRY_DSN=https://<your-sentry-dsn>@sentry.io/<project-id>
