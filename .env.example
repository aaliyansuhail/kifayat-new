[TEMPLATE]
# Copy to kifayat-backend/.env and fill in real values. Never commit .env.

# ── Core ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/kifayat
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

# Public origin used in emailed links. Must match the deployed storefront.
PUBLIC_APP_URL=http://localhost:5173

# Comma-separated admins.
ADMIN_EMAILS=admin@example.com

# ── Transactional email (Gmail SMTP) ──────────────────────────────
# All transactional mail (OTPs, order confirmations, receipts, admin alerts) is
# sent through a single Gmail account using an App Password. Run
# `npm run email:check` to diagnose, and add --send you@x.com to send a real
# test message.

# EMAIL_PASS must be a 16-character Google "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords), NOT the
# account password. A 535 "Username and Password not accepted" means this value
# is wrong or 2-Step Verification is off.
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_16_char_app_password

# Optional: where customer replies should go.
REPLY_TO_EMAIL=support@your-domain.com

# ── Search / tracking ───────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
